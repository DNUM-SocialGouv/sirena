        "lib/type": "mbql.stage/native",
        "native": "-- Carte : « Nombre de comptes actifs par entité »\n-- Comptes utilisateurs au statut ACTIF, regroupés par entité de rattachement.\nSELECT\n  COALESCE(NULLIF(e.\"nomComplet\", ''), e.label, 'Non rattaché à une entité') AS \"Entité\",\n  COUNT(*)                                                                   AS \"Nombre de comptes actifs\"\nFROM \"User\" u\nLEFT JOIN \"Entite\" e ON e.id = u.\"entiteId\"\nWHERE u.\"statutId\" = 'ACTIF'\n  [[ AND u.\"createdAt\" >= {{start_date}} ]]\n  [[ AND u.\"createdAt\" <  ({{end_date}}::date + INTERVAL '1 day') ]]\nGROUP BY COALESCE(NULLIF(e.\"nomComplet\", ''), e.label, 'Non rattaché à une entité')\nORDER BY COUNT(*) DESC, 1 ASC;",
