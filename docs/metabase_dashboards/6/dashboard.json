                  "id": "7ca1a556-dabf-4e19-9e5b-fcb8656fc6de",
                  "name": "inclure_eig",
                  "type": "boolean"
                }
              ]
            }
          ]
        },
        "description": "Requêtes ayant au moins un motif « Maltraitance professionnels ou entourage », comptées selon leur date de création dans SIRENA",
