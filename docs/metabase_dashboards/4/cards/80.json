    "lib/type": "mbql/query",
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "-- Carte : « Répartition des requêtes par priorité »\nWITH requetes AS (\n  SELECT DISTINCT re.\"requeteId\" AS requete_id, re.\"prioriteId\" AS priorite_id\n  FROM \"RequeteEntite\" re\n  JOIN \"Entite\"  e ON e.id = re.\"entiteId\"\n  JOIN \"Requete\" r ON r.id = re.\"requeteId\"\n  WHERE e.label = {{entity_label}}\n    [[ AND r.\"createdAt\" >= {{start_date}} ]]\n    [[ AND r.\"createdAt\" <  ({{end_date}}::date + INTERVAL '1 day') ]]\n    [[ AND EXISTS (SELECT 1 FROM \"Situation\" s_df\n                   WHERE s_df.\"requeteId\" = r.id\n                     AND s_df.\"domainesFonctionnelsId\" IN ({{domaine_fonctionnel}})) ]]\n    [[ AND NOT EXISTS (SELECT 1 FROM \"PersonneConcernee\" pc_eig\n                       WHERE pc_eig.\"declarantDeId\" = r.id\n                         AND pc_eig.\"estSignalementProfessionnel\" IS TRUE\n                         AND {{inclure_eig}} = 'false') ]]\n),\ntotal AS (SELECT COUNT(*) AS nb_total FROM requetes),\npar_priorite AS (\n  SELECT\n    COALESCE(p.label, 'Aucune priorité') AS priorite,\n    COALESCE(p.\"sortOrder\", 99)          AS tri,\n    COUNT(*)                             AS nb_requetes\n  FROM requetes q\n  LEFT JOIN \"RequetePrioriteEnum\" p ON p.id = q.priorite_id\n  GROUP BY COALESCE(p.label, 'Aucune priorité'), COALESCE(p.\"sortOrder\", 99)\n)\nSELECT\n  pp.priorite                                              AS \"Priorité\",\n  pp.nb_requetes                                           AS \"Nombre de requêtes\",\n  ROUND(100.0 * pp.nb_requetes / NULLIF(t.nb_total, 0), 1) AS \"Part des requêtes (%)\"\nFROM par_priorite pp\nCROSS JOIN total t\nORDER BY pp.tri;",
